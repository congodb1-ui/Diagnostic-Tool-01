    {
      "id": "overlay-network",
      "name": "NSX Overlay & BFD Transport (Informational)",
      "category": "Overlay",
      "description": "Transport telemetry ports for NSX Geneve encapsulation and BFD link status. TEP-to-TEP traffic cannot be probed from a standard workstation; use the ESXi command helper.",
      "rolesUsed": ["tep"],
      "defaultRoleTargets": {
        "tep": "192.0.2.100"
      },
      "defaultTargetLabel": "tep-node.example",
      "targetSource": "discovered",
      "mtuSettings": {
        "defaultPathMtu": 1600,
        "thresholdNote": "Unverified default, confirm for your design",
        "source": "Broadcom KB 455157",
        "verifyAgainstVersion": "Verify against your NSX version"
      },
      "rules": [
        {
          "id": "nsx-udp-6081",
          "label": "Geneve Overlay Transport",
          "protocol": "UDP",
          "port": "6081",
          "direction": "TEP to TEP",
          "targetRole": "tep",
          "flowSource": "TEP",
          "flowDestination": "TEP",
          "testableFromHere": false,
          "requiresAdmin": true,
          "requiresResponder": true,
          "purpose": "UDP 6081 Geneve overlay data plane encapsulation",
          "source": "Broadcom KB 455157",
          "verifyAgainstVersion": "Verify against your NSX version",
          "enabled": true
        },
        {
          "id": "nsx-udp-3784",
          "label": "BFD Single-Hop Keepalive",
          "protocol": "UDP",
          "port": "3784",
          "direction": "Edge to Host / TOR",
          "targetRole": "tep",
          "flowSource": "Edge node",
          "flowDestination": "Host / Top-of-Rack",
          "testableFromHere": false,
          "requiresAdmin": true,
          "requiresResponder": true,
          "purpose": "UDP 3784 BFD single-hop sub-second failure detection",
          "source": "Broadcom KB 455157",
          "verifyAgainstVersion": "Verify against your NSX version",
          "enabled": true
        },
        {
          "id": "nsx-udp-4784",
          "label": "BFD Multi-Hop Keepalive",
          "protocol": "UDP",
          "port": "4784",
          "direction": "Edge to Upstream Router",
          "targetRole": "tep",
          "flowSource": "Edge node",
          "flowDestination": "Upstream router",
          "testableFromHere": false,
          "requiresAdmin": true,
          "requiresResponder": true,
          "purpose": "UDP 4784 BFD multi-hop session keepalive",
          "source": "Broadcom KB 455157",
          "verifyAgainstVersion": "Verify against your NSX version",
          "enabled": true
        }
      ]
    },
