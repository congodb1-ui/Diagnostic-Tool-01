          "port": "636",
          "direction": "AVS to On-Prem",
          "targetRole": "ad-controller",
          "flowSource": "Private cloud vCenter",
          "flowDestination": "On-premises Active Directory",
          "testableFromHere": false,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Optional LDAPS 636 secure directory service",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "TLS / AD DS",
          "enabled": true
        },
        {
          "id": "ad-tcp-3268",
          "label": "Global Catalog LDAP 3268 (Optional)",
          "protocol": "TCP",
          "port": "3268",
          "direction": "AVS to On-Prem",
          "targetRole": "ad-controller",
          "flowSource": "Private cloud vCenter",
          "flowDestination": "On-premises Global Catalog",
          "testableFromHere": false,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Optional Global Catalog 3268 search across forest",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "Active Directory GC",
          "enabled": true
        },
        {
          "id": "ad-tcp-3269",
          "label": "Global Catalog LDAPS 3269 (Optional)",
          "protocol": "TCP",
          "port": "3269",
          "direction": "AVS to On-Prem",
          "targetRole": "ad-controller",
          "flowSource": "Private cloud vCenter",
          "flowDestination": "On-premises Global Catalog",
          "testableFromHere": false,
          "requiresAdmin": false,
