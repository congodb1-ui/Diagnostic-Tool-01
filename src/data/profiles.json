          "enabled": true
        }
      ]
    },
    {
      "id": "dns-ad",
      "name": "DNS and AD",
      "category": "Identity",
      "description": "Verifies bidirectional DNS lookups and optional Active Directory identity integration ports between on-premises and the private cloud.",
      "rolesUsed": ["dns-server", "ad-controller"],
      "defaultRoleTargets": {
        "dns-server": "192.0.2.53",
        "ad-controller": "192.0.2.88"
      },
      "defaultTargetLabel": "dc01.example",
      "targetSource": "typed",
      "mtuSettings": {
        "defaultPathMtu": 1500,
        "thresholdNote": "Unverified default, confirm for your design",
        "source": "Zaboraa internal, to be verified",
        "verifyAgainstVersion": "Confirm Active Directory service ports with your identity team"
      },
      "rules": [
        {
          "id": "dns-udp-53-out",
          "label": "DNS Query (On-Prem to AVS)",
          "protocol": "UDP",
          "port": "53",
          "direction": "On-Prem to AVS",
          "targetRole": "dns-server",
          "flowSource": "On-prem workloads",
          "flowDestination": "Private cloud DNS forwarder",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": true,
          "purpose": "Standard DNS lookups for private cloud records",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "Standard DNS RFC 1035",
          "enabled": true
        },
        {
          "id": "dns-udp-53-in",
          "label": "DNS Query (Private Cloud to On-Prem)",
          "protocol": "UDP",
          "port": "53",
          "direction": "AVS to On-Prem",
          "targetRole": "dns-server",
          "flowSource": "Private cloud DNS forwarder",
          "flowDestination": "On-premises DNS server",
          "testableFromHere": false,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "UDP 53 both ways between private cloud and on-premises DNS",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "Standard DNS RFC 1035",
          "enabled": true
        },
        {
          "id": "ad-tcp-389",
          "label": "LDAP Directory Service (Optional)",
          "protocol": "TCP",
          "port": "389",
          "direction": "AVS to On-Prem",
          "targetRole": "ad-controller",
          "flowSource": "Private cloud vCenter",
          "flowDestination": "On-premises Active Directory",
          "testableFromHere": false,
          "requiresAdmin": false,
          "requiresResponder": false,
