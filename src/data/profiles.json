{
  "profiles": [
    {
      "id": "hcx-precheck",
      "name": "HCX Pre-Check",
      "category": "Migration",
      "description": "Evaluates connectivity between on-premises and private cloud management endpoints for VMware HCX management, migration control, and interconnect tunnels.",
      "rolesUsed": ["hcx-manager", "hcx-interconnect", "esxi-host"],
      "defaultRoleTargets": {
        "hcx-manager": "192.0.2.10",
        "hcx-interconnect": "192.0.2.20",
        "esxi-host": ["192.0.2.31", "192.0.2.32"]
      },
      "defaultTargetLabel": "hcx-mgr.example",
      "targetSource": "typed",
      "mtuSettings": {
        "defaultPathMtu": 1500,
        "thresholdNote": "Unverified default, confirm for your design",
        "source": "Zaboraa internal, to be verified",
        "verifyAgainstVersion": "Confirm underlay and circuit MTU requirements with your design team"
      },
      "rules": [
        {
          "id": "hcx-tcp-443",
          "label": "HCX Manager Web & REST API",
          "protocol": "TCP",
          "port": "443",
          "direction": "On-Prem to AVS",
          "targetRole": "hcx-manager",
          "flowSource": "On-prem admin workstation / HCX Connector",
          "flowDestination": "HCX Cloud Manager",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HCX Cloud Manager management, site pairing, and configuration API",
          "source": "Microsoft Learn, \"Networking planning checklist for Azure VMware Solution\", and Broadcom HCX Security Information",
          "verifyAgainstVersion": "HCX 4.0+",
          "enabled": true
        },
        {
          "id": "hcx-tcp-9443",
          "label": "HCX Appliance Management (VAMI)",
          "protocol": "TCP",
          "port": "9443",
          "direction": "On-Prem to AVS",
          "targetRole": "hcx-manager",
          "flowSource": "On-prem admin workstation",
          "flowDestination": "HCX Cloud Manager VAMI",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HCX appliance lifecycle and administration portal",
          "source": "Microsoft Learn, \"Networking planning checklist for Azure VMware Solution\", and Broadcom HCX Security Information",
          "verifyAgainstVersion": "HCX 4.0+",
          "enabled": true
        },
        {
          "id": "hcx-tcp-8123",
          "label": "Bulk Migration Replication Control",
          "protocol": "TCP",
          "port": "8123",
          "direction": "On-Prem to AVS",
          "targetRole": "hcx-interconnect",
          "flowSource": "HCX Manager",
          "flowDestination": "HCX Interconnect (IX)",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HCX Manager to interconnect bulk migration control",
          "source": "Microsoft Learn, \"Networking planning checklist for Azure VMware Solution\", and Broadcom HCX Security Information",
          "verifyAgainstVersion": "HCX 4.2+",
          "enabled": true
        },
        {
          "id": "hcx-tcp-80",
          "label": "ESXi HTTP Redirection",
          "protocol": "TCP",
          "port": "80",
          "direction": "HCX to ESXi",
          "targetRole": "esxi-host",
          "flowSource": "HCX Manager and Interconnect",
          "flowDestination": "ESXi hosts",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HTTP redirection to 443 and initial host communication",
          "source": "Broadcom HCX Security Information",
          "verifyAgainstVersion": "ESXi 7.0/8.0",
          "enabled": true
        },
        {
          "id": "hcx-tcp-443-esxi",
          "label": "ESXi HTTPS Management",
          "protocol": "TCP",
          "port": "443",
          "direction": "HCX to ESXi",
          "targetRole": "esxi-host",
          "flowSource": "HCX Manager and Interconnect",
          "flowDestination": "ESXi hosts",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HTTPS host management and provisioning",
          "source": "Broadcom HCX Security Information",
          "verifyAgainstVersion": "ESXi 7.0/8.0",
          "enabled": true
        },
        {
          "id": "hcx-tcp-902",
          "label": "ESXi NFC Disk Stream",
          "protocol": "TCP",
          "port": "902",
          "direction": "HCX-IX to ESXi",
          "targetRole": "esxi-host",
          "flowSource": "HCX Interconnect",
          "flowDestination": "ESXi hosts",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Network File Copy (NFC) VMDK disk replication",
          "source": "Broadcom HCX Security Information",
          "verifyAgainstVersion": "ESXi 7.0/8.0",
          "enabled": true
        },
        {
          "id": "hcx-tcp-8000",
          "label": "vMotion Stream",
          "protocol": "TCP",
          "port": "8000",
          "direction": "vCenter Network to Management Network",
          "targetRole": "esxi-host",
          "flowSource": "On-premises vCenter network",
          "flowDestination": "Private cloud management network",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Live workload memory and device state migration",
          "source": "Microsoft Learn, \"Networking planning checklist for Azure VMware Solution\", and Broadcom HCX Security Information",
          "verifyAgainstVersion": "vSphere 7.0+",
          "enabled": true
        },
        {
          "id": "hcx-udp-4500",
          "label": "HCX-IX IPsec / NAT-T Tunnel",
          "protocol": "UDP",
          "port": "4500",
          "direction": "Interconnect to Interconnect",
          "targetRole": "hcx-interconnect",
          "flowSource": "HCX Interconnect",
          "flowDestination": "HCX Interconnect",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": true,
          "purpose": "Between interconnect appliances (IPsec/NAT-T tunnel)",
          "source": "Broadcom HCX Security Information",
          "verifyAgainstVersion": "Requires UDP responder on target for authoritative verification",
          "enabled": true
        },
        {
          "id": "hcx-tcp-5201",
          "label": "Interconnect Uplink Test (TCP)",
          "protocol": "TCP",
          "port": "5201",
          "direction": "Interconnect to Interconnect",
          "targetRole": "hcx-interconnect",
          "flowSource": "HCX Interconnect",
          "flowDestination": "HCX Interconnect",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Interconnect uplink throughput test (HCX 4.8 and later)",
          "source": "Broadcom HCX Security Information",
          "verifyAgainstVersion": "HCX 4.8 and later",
          "enabled": true
        },
        {
          "id": "hcx-udp-5201",
          "label": "Interconnect Uplink Test (UDP)",
          "protocol": "UDP",
          "port": "5201",
          "direction": "Interconnect to Interconnect",
          "targetRole": "hcx-interconnect",
          "flowSource": "HCX Interconnect",
          "flowDestination": "HCX Interconnect",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": true,
          "purpose": "Interconnect uplink loss/jitter test (HCX 4.8 and later)",
          "source": "Broadcom HCX Security Information",
          "verifyAgainstVersion": "HCX 4.8 and later",
          "enabled": true
        }
      ]
    },
    {
      "id": "vcenter-nsx-access",
      "name": "vCenter and NSX Access",
      "category": "Management",
      "description": "Tests administrative connectivity to private Azure VMware Solution management endpoints (vCenter Server appliance and NSX Manager cluster).",
      "rolesUsed": ["vcenter", "nsx-manager"],
      "defaultRoleTargets": {
        "vcenter": "192.0.2.11",
        "nsx-manager": "192.0.2.12"
      },
      "defaultTargetLabel": "vcsa.example",
      "targetSource": "discovered",
      "mtuSettings": {
        "defaultPathMtu": 1500,
        "thresholdNote": "Unverified default, confirm for your design",
        "source": "Zaboraa internal, to be verified",
        "verifyAgainstVersion": "Confirm MTU settings with your network team"
      },
      "rules": [
        {
          "id": "vc-tcp-443",
