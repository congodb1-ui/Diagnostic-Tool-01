          "protocol": "TCP",
          "port": "443",
          "direction": "On-Prem to AVS",
          "targetRole": "vcenter",
          "flowSource": "On-prem admin workstation",
          "flowDestination": "AVS vCenter Server",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "vSphere Client and automation REST API access",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "vCenter 7.0+/8.0+",
          "enabled": true
        },
        {
          "id": "vc-tcp-80",
          "label": "vCenter HTTP Redirect",
          "protocol": "TCP",
          "port": "80",
          "direction": "On-Prem to AVS",
          "targetRole": "vcenter",
          "flowSource": "On-prem admin workstation",
          "flowDestination": "AVS vCenter Server",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HTTP port 80 redirects to 443",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "vCenter 7.0+/8.0+",
          "enabled": true
        },
        {
          "id": "nsx-tcp-443",
          "label": "NSX Manager HTTPS UI & API",
          "protocol": "TCP",
          "port": "443",
          "direction": "On-Prem to AVS",
          "targetRole": "nsx-manager",
          "flowSource": "On-prem admin workstation",
          "flowDestination": "AVS NSX-T Manager",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "NSX Manager UI and REST API management",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "NSX 3.2+/4.1+",
          "enabled": true
        },
        {
          "id": "nsx-tcp-80",
          "label": "NSX Manager HTTP Redirect",
          "protocol": "TCP",
          "port": "80",
          "direction": "On-Prem to AVS",
          "targetRole": "nsx-manager",
          "flowSource": "On-prem admin workstation",
          "flowDestination": "AVS NSX-T Manager",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "HTTP port 80 redirects to 443",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "NSX 3.2+/4.1+",
          "enabled": true
        }
      ]
    },
    {
      "id": "expressroute-reachability",
      "name": "ExpressRoute / Global Reach Reachability",
      "category": "Transport",
      "description": "Verifies reachability to user-specified AVS endpoints over ExpressRoute private peering using TCP 443 and inspects IP address plan CIDR overlap risks.",
      "rolesUsed": ["vcenter", "nsx-manager", "hcx-manager"],
      "defaultRoleTargets": {
        "vcenter": "192.0.2.11",
        "nsx-manager": "192.0.2.12",
        "hcx-manager": "192.0.2.10"
      },
      "defaultTargetLabel": "endpoints.example",
      "targetSource": "typed",
      "mtuSettings": {
        "defaultPathMtu": 1500,
        "thresholdNote": "Unverified default, confirm for your design",
        "source": "Zaboraa internal, to be verified",
        "verifyAgainstVersion": "Confirm MTU settings with your ExpressRoute provider"
      },
      "rules": [
        {
          "id": "er-vcenter-tcp-443",
          "label": "AVS vCenter Reachability",
          "protocol": "TCP",
          "port": "443",
          "direction": "On-Prem to AVS",
          "targetRole": "vcenter",
          "flowSource": "On-prem network",
          "flowDestination": "AVS vCenter endpoint",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Verify TCP three-way handshake across ExpressRoute peering to vCenter",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "Standard TCP",
          "enabled": true
        },
        {
          "id": "er-nsx-tcp-443",
          "label": "AVS NSX Manager Reachability",
          "protocol": "TCP",
          "port": "443",
          "direction": "On-Prem to AVS",
          "targetRole": "nsx-manager",
          "flowSource": "On-prem network",
          "flowDestination": "AVS NSX Manager endpoint",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Verify TCP three-way handshake across ExpressRoute peering to NSX Manager",
          "source": "Zaboraa internal, to be verified",
          "verifyAgainstVersion": "Standard TCP",
          "enabled": true
        },
        {
          "id": "er-hcx-tcp-443",
          "label": "AVS HCX Cloud Manager Reachability",
          "protocol": "TCP",
          "port": "443",
          "direction": "On-Prem to AVS",
          "targetRole": "hcx-manager",
          "flowSource": "On-prem network",
          "flowDestination": "AVS HCX Manager endpoint",
          "testableFromHere": true,
          "requiresAdmin": false,
          "requiresResponder": false,
          "purpose": "Verify TCP three-way handshake across ExpressRoute peering to HCX Manager",
          "source": "Zaboraa internal, to be verified",
